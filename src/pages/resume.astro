---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { SITE } from "@config";
import resumePDF from "../assets/resume.pdf";

const title = "Resume";
---

<Layout title={`${title} | ${SITE.title}`}>
  <Header activeNav="resume" />
  <Breadcrumbs />
  <main id="main-content">
    <section class="mx-auto max-w-3xl px-4 pb-12 pt-6">
      <h1 class="text-2xl font-semibold sm:text-3xl mb-8">Resume</h1>
      
      <!-- Download Button -->
      <div class="mb-8">
        <a 
          href={resumePDF}
          download="resume-Himanshu(DevOps).pdf"
          class="inline-flex items-center gap-2 rounded-lg bg-skin-accent px-4 py-2 text-skin-inverted hover:opacity-90 transition-opacity"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Resume PDF
        </a>
      </div>

      <!-- Summary Section -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">Summary</h2>
        <div class="text-skin-base leading-relaxed space-y-4">
          <p>
            I am a <b>Kubestronaut and AWS certified DevOps Engineer</b> with experience building and managing production infrastructure across AWS and GCP.
          </p>
          <p>
            You can find a gist of what I've done till now and download my resume as well from the link above!
          </p>
          <p>
            You can also checkout my Kubestronaut status from <a
              href="https://www.cncf.io/training/kubestronaut/?_sft_lf-country=in&p=himanshu-gaikwad"
              class="text-skin-accent hover:text-skin-accent-hover underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              cncf.io/training/kubestronaut
            </a>
          </p>
        </div>
      </section>

      <!-- Experience Section -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">Experience</h2>

        <div class="space-y-6">
          <!-- Job 1 -->
          <div class="border-l-2 border-skin-line pl-4">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="text-lg font-semibold text-skin-base">DevOps Engineer</h3>
              <p class="text-sm text-skin-base opacity-80">Jan 2026 - Present</p>
            </div>
            <p class="text-sm text-skin-base opacity-80 mb-2">
              100ms (100ms.live and 100ms.ai) • Bengaluru, India
            </p>
            <ul class="list-disc list-inside space-y-1 text-skin-base">
              <li>Own infrastructure for two production SaaS platforms - a global video/audio product and a HIPAA-regulated AI voice-agent platform in US healthcare — as one of two engineers on the team.</li>
              <li>Re-platformed CD from FluxCD to standardized ArgoCD GitOps with Kyverno-gated production approvals, cutting average deployment time from 30+ min to 10 min while enforcing consistent HA, autoscaling, and PDB configs.</li>
              <li>Delivered a HIPAA-compliant air-gapped AWS landing zone for an enterprise client via Terraform with self-hosted LLM pipeline using Temporal, Langfuse, Deepgram, SonarQube and ClickHouse automating referrals workflow for a major US pharmaceutical distributor using AI agents.</li>
              <li>Migrated org-wide CI from GitHub-hosted to self-hosted ARC runners on spot nodes, segmented by build vs. light-CI workloads, cutting CI/CD costs from $3,000 to $700/month.</li>
              <li>Consolidated observability with LGTM stack to VictoriaMetrics, cutting query latency to under 5 seconds on large-scale queries and reducing infra costs 20% by replacing a large Prometheus installation with lightweight VMAgents.</li>
              <li>Built a CronJob and initContainer-based system to auto-attach reserved static IPs to GKE nodes serving SIP/TURN traffic, eliminating a recurring manual failure point on node churn and provide IP-whitelisting for SIP services for clients.</li>
              <li>Led remediation and evidence collection for SOC 2 and HIPAA certification of a newly formed AI org, hardening infrastructure and CI/CD controls to help the org achieve the certifications.</li>
            </ul>
          </div>

          <!-- Job 2 -->
          <div class="border-l-2 border-skin-line pl-4">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="text-lg font-semibold text-skin-base">SDE - DevOps</h3>
              <p class="text-sm text-skin-base opacity-80">Nov 2023 - Jan 2026</p>
            </div>
            <p class="text-sm text-skin-base opacity-80 mb-2">
              IDfy • Mumbai, India
            </p>
            <ul class="list-disc list-inside space-y-1 text-skin-base">
              <li>Lead team of 4 engineers in architecting and migrating 90+ microservices to Kubernetes Gateway API across 40+ production clusters, reducing load balancer costs by 70%. Mentored team on zero-downtime deployments using Argo Rollouts through hands-on code reviews and sprint planning.</li>
              <li>Designed and implemented autoscaling GitLab CI infrastructure managing 100+ daily pipeline executions across hybrid VM/Kubernetes environments, reducing operations costs by 25% while improving build reliability.</li>
              <li>Developed an AI agent platform using Google’s ADK with modular MCP integration capabilities, enabling plug-and-play functionality for multiple protocols deployed via Google Vertex AI Engine.</li>
              <li>Achieved 95%+ CIS benchmark compliance across 4 AWS single-tenant environments, implementing automated security controls, configuration management, and compliance monitoring to meet enterprise cybersecurity requirements.</li>
              <li>Deployed the flagship vKYC product from scratch on a single-tenant AWS setup within one week for a major bank, including landing-zone setup and migration of all Alpine-based Docker images to Red Hat UBI 8.</li>
              <li>Deployed Wazuh SIEM in a multi-tenant cloud setup to monitor and secure public-facing compute endpoints.</li>
              <li>Developed an in-house semantic versioning tool in Go to automate application release management across teams.</li>
            </ul>
          </div>
        </div>
      </section>


      <!-- Certifications Section (Optional) -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">Certifications</h2>
        
        <ul class="space-y-2 text-skin-base">
          <li>• <b>Kubestronaut</b> - The Linux Foundation</li>
          <li>• <b>AWS Solutions Architect Associate</b> - AWS</li>
          <li>• <b>AWS Solutions Architect Associate</b> - AWS</li>
        </ul>
      </section>

      <!-- Skills Section -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">Skills</h2>
        
        <div class="space-y-4">
          <div>
            <div class="flex flex-wrap gap-2">
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Kubernetes</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">AWS/GCP</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">IaC (Terraform)</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Monitoring and Logging (Prometheus-Grafana stack and EFK)</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">GitOps (ArgoCD)</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">CI/CD (Gitlab and GitHub)</span>
              <span class="inline-block bg-skin-card px-3 py-1 rounded-full text-sm border border-skin-line">Go, Bash and Python</span>
              <!-- Add more skills as needed -->
            </div>
          </div>
        </div>
      </section>

      <!-- Education Section -->
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 text-skin-accent">Education</h2>
        
        <div class="space-y-4">
          <div class="border-l-2 border-skin-line pl-4">
            <h3 class="text-lg font-semibold text-skin-base">B.Tech in CSE</h3>
            <p class="text-sm text-skin-base opacity-80">
              SRM University • Delhi-NCR • 2019-2023
            </p>
          </div>
        </div>
      </section>

    </section>
  </main>
  <Footer />
</Layout>